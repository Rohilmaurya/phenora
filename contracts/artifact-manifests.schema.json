{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phenora:contracts:artifact-manifests.schema.json",
  "title": "Phenora replaceable artifact manifests",
  "description": "Stable manifests for swapping a compact hackathon model/data pack for larger deployment artifacts without changing application or API code.",
  "oneOf": [
    {"$ref": "#/$defs/DataPackManifest"},
    {"$ref": "#/$defs/ModelPackManifest"}
  ],
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ArtifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256", "size_bytes", "license"],
      "properties": {
        "role": {"type": "string", "enum": ["ontology", "annotations", "term_index", "disease_index", "model_weights", "tokenizer", "template"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*\\.\\.)(?![A-Za-z]:)[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "license": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "DataPackManifest": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {"properties": {"files": {"contains": {"type": "object", "properties": {"role": {"const": "ontology"}}, "required": ["role"]}}}},
        {"properties": {"files": {"contains": {"type": "object", "properties": {"role": {"const": "annotations"}}, "required": ["role"]}}}}
      ],
      "required": ["schema_version", "pack_id", "created_at", "ontology", "annotations", "selection", "counts", "files"],
      "properties": {
        "schema_version": {"type": "string", "const": "phenora-data-v1"},
        "pack_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "created_at": {"type": "string", "format": "date"},
        "ontology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "sha256", "source", "license"],
          "properties": {
            "release": {"type": "string", "minLength": 1, "maxLength": 40},
            "sha256": {"$ref": "#/$defs/Sha256"},
            "source": {"type": "string", "format": "uri"},
            "license": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["release", "sha256", "source", "license"],
          "properties": {
            "release": {"type": "string", "minLength": 1, "maxLength": 40},
            "sha256": {"$ref": "#/$defs/Sha256"},
            "source": {"type": "string", "format": "uri"},
            "license": {"type": "string", "minLength": 1, "maxLength": 160}
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "method", "selection_version"],
          "properties": {
            "scope": {"type": "string", "enum": ["full_release", "curated_subset"]},
            "method": {"type": "string", "minLength": 1, "maxLength": 300},
            "selection_version": {"type": "string", "minLength": 1, "maxLength": 80}
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hpo_terms", "diseases", "associations"],
          "properties": {
            "hpo_terms": {"type": "integer", "minimum": 0},
            "diseases": {"type": "integer", "minimum": 0},
            "associations": {"type": "integer", "minimum": 0}
          }
        },
        "files": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ArtifactFile"}}
      }
    },
    "ModelPackManifest": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {"properties": {"files": {"contains": {"type": "object", "properties": {"role": {"const": "model_weights"}}, "required": ["role"]}}}}
      ],
      "required": ["schema_version", "pack_id", "runtime", "model_id", "model_version", "weights_sha256", "extraction_schema_version", "languages", "limits", "files"],
      "properties": {
        "schema_version": {"type": "string", "const": "phenora-model-v1"},
        "pack_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "runtime": {"type": "string", "enum": ["ollama", "lm_studio"]},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 120},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "weights_sha256": {"$ref": "#/$defs/Sha256"},
        "extraction_schema_version": {"type": "string", "const": "phenotype-extraction-v1"},
        "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 35}},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_input_chars", "timeout_seconds", "minimum_ram_gb"],
          "properties": {
            "max_input_chars": {"type": "integer", "minimum": 1, "maximum": 50000},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
            "minimum_ram_gb": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ArtifactFile"}}
      }
    }
  }
}
